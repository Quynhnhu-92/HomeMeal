# Smart Menu calls Gemini on the server only. Never use a VITE_ prefix for this key.
# Vercel: Settings -> Environment Variables, then redeploy. Samples work without a key.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL/Neon connection string (use a separate development branch for local work).
# Neon production on Vercel: use the pooled URL and verified TLS. Never commit the value.
DATABASE_URL=""

# Local development origin; set this to the exact production domain in Vercel.
APP_ORIGIN="http://localhost:3000"

# Set these locally only when creating the first administrator, then remove them.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="HomeMeal Admin"
